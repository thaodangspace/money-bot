{
  "tasks": {
    "check": "deno check --lock=deno.lock src/main.ts",
    "test": "deno test --lock=deno.lock --allow-net=127.0.0.1 --allow-read=testdata src",
    "test:coverage": "deno test --lock=deno.lock --coverage=.coverage --allow-net=127.0.0.1 --allow-read=testdata src",
    "fmt:check": "deno fmt --check src deno.json",
    "lint": "deno lint src",
    "dev:lmstudio": "deno run --watch --allow-read=config.yaml --allow-env --allow-net src/main.ts",
    "start:openrouter": "deno run --allow-read=config.yaml --allow-env --allow-net src/main.ts",
    "telegram:webhook:set": "deno run --allow-env --allow-net=api.telegram.org src/tools/telegram_webhook.ts set",
    "telegram:webhook:info": "deno run --allow-env --allow-net=api.telegram.org src/tools/telegram_webhook.ts info",
    "telegram:webhook:delete": "deno run --allow-env --allow-net=api.telegram.org src/tools/telegram_webhook.ts delete"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true
  },
  "lint": {
    "rules": {
      "exclude": ["no-window"]
    }
  }
}
