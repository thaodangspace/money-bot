# Deno Deploy / environment-only configuration
TELEGRAM_BOT_TOKEN=123456:your-bot-token
TELEGRAM_ALLOWED_USER_ID=123456789
TELEGRAM_MAX_IMAGE_BYTES=5242880
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace-with-random-telegram-webhook-secret

GOOGLE_SHEET_ID=your_spreadsheet_id

# Choose exactly one Google credential source.
# Option A: legacy service-account fields:
GOOGLE_SERVICE_ACCOUNT_EMAIL=money-bot@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option B: full service-account JSON. If set, remove/leave the legacy fields unset.
# GOOGLE_CREDENTIALS_JSON='{"type":"service_account","client_email":"...","private_key":"..."}'

# Optional runtime settings
# GOOGLE_METADATA_SHEET=_money_bot_meta
# GOOGLE_PENDING_SHEET=_money_bot_pending
# GOOGLE_REQUEST_TIMEOUT=30s
# APP_PORT=8000
# APP_TIMEZONE=Asia/Ho_Chi_Minh
# APP_UPDATE_TIMEOUT=30s
# APP_SHUTDOWN_TIMEOUT=10s
# APP_MAX_INPUT_RUNES=2000
# APP_MAX_OUTPUT_RUNES=3900

# AI is always enabled. Deno Deploy should use a remote provider.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-your-key
AI_MODEL=z-ai/glm-4.5-air:free
AI_IMAGE_MODEL=google/gemini-2.0-flash-exp:free
AI_BASE_URL=https://openrouter.ai/api/v1
AI_REQUEST_TIMEOUT=20s
# OPENROUTER_MODEL=z-ai/glm-4.5-air:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_REFERER=https://github.com/thaodangspace/money-bot
# OPENROUTER_APP_NAME=money-bot
